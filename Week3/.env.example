# Copy this file to Week3/.env and fill in local values. NEVER commit Week3/.env.
# These are LOCAL, SYNTHETIC-ONLY development credentials — not real secrets.

# Tier 3 — local Postgres (used by both the db and api services)
DB_USER=accountability
DB_PASSWORD=change-me-locally
DB_NAME=accountability

# Tier 2 — data discipline gate. The app refuses to start unless this is
# exactly "synthetic". Do not change it this phase.
DATA_MODE=synthetic
