# -----------------------------------------------------------------------------
# DEPLOYED PATH (current): Supabase + Vercel.
# The front end talks directly to Supabase. Its config lives with the web app in
#   web/.env.example  ->  copy to web/.env
# and is set as Vercel project env vars:
#   VITE_SUPABASE_URL        (Supabase Project URL — public)
#   VITE_SUPABASE_ANON_KEY   (Supabase anon/publishable key — public, RLS-gated)
# Never commit web/.env, and never put the Supabase service_role key anywhere
# client-side.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# LEGACY (retired from the deployed path): local Docker + FastAPI stack.
# The api/ folder and docker-compose.yml are kept for reference but are no longer
# part of the deployed app. These vars only matter if you run that local stack.
# They are LOCAL, SYNTHETIC-ONLY development values — not real secrets.
# -----------------------------------------------------------------------------

# Tier 3 — local Postgres (used by the legacy db and api services)
DB_USER=accountability
DB_PASSWORD=change-me-locally
DB_NAME=accountability

# Tier 2 — data discipline gate. The legacy app refuses to start unless this is
# exactly "synthetic".
DATA_MODE=synthetic
