# Copy this file to web/.env and fill in your Supabase project values.
# NEVER commit web/.env (it is git-ignored). These are the only two values the
# front end needs.
#
# Both are PUBLIC by design: the anon key is a publishable key, meant to ship in
# the browser, and access is controlled by Row Level Security on Supabase. Do NOT
# put the Supabase service_role key here — it bypasses RLS and must never reach
# the browser.
#
# Find these in Supabase Studio -> Project Settings -> API:
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "Project API keys" -> anon / public key

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
