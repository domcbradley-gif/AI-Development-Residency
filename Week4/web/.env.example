# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local (it is git-ignored). These are the only two values the
# browser needs for the anonymous contribution flow.
#
# Both are PUBLIC by design: the anon key is a publishable key meant to ship in
# the browser, gated by Row Level Security on Supabase. Do NOT put the Supabase
# service_role key in a NEXT_PUBLIC_ var — it bypasses RLS and must never reach
# the browser. (Server-only secrets, added in later slices, use un-prefixed names.)
#
# Find these in Supabase Studio -> Project Settings -> API:
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "Project API keys" -> anon / public key

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
